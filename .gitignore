.Rproj.user
.Rhistory
.RData
.Ruserdata
.DS_Store

# Canonical agent skills live under skills/ (versioned).
# Optional IDE shim: .cursor/skills/prong1-trajectories → ../../skills/prong1-trajectories
# Ignore other local Cursor IDE state if present.
.cursor/*
!.cursor/skills/
!.cursor/skills/prong1-trajectories
renv/library/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/
renv/staging/

# Local EHR schemas / SQL (not shared in git)
global_ehrs/

# Generated demo EHR (recreate with scripts/00_generate_dummy_data.R)
data/raw/dummy/*.csv
data/raw/dummy/*.json
data/raw/dummy_50k/*.csv
data/raw/dummy_50k/*.json
data/raw/dummy_dirty/*.csv
data/raw/dummy_dirty/*.json

# Pipeline outputs
data/processed/prong1_input/*
!data/processed/prong1_input/.gitkeep
data/processed/prong1_input_dirty/*
!data/processed/prong1_input_dirty/.gitkeep
data/processed/prong1_trajectories/*
!data/processed/prong1_trajectories/.gitkeep
reports/figures/*
!reports/figures/.gitkeep
